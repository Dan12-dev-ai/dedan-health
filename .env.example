# =============================================================================
# DEDAN Health — root example environment file
#
# The backend reads its configuration from `backend-v2/.env` (see
# `backend-v2/app/core/config.py`, which sets `env_file = ".env"` and is loaded
# relative to the backend working directory). This root file documents the
# variables that matter for running the whole system and is safe to commit.
#
#   cp backend-v2/.env.example backend-v2/.env
#
# NEVER commit a populated .env. Only `*.example` files are tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# AI provider mode
# -----------------------------------------------------------------------------
# offline | mock | local | rules  -> deterministic rules engine. No network,
#                                    no credentials, $0 cost. This is the
#                                    default and what CI exercises.
# Any other value permits live provider calls, but only when a usable
# credential is configured (see providers/provider_factory.py, which also
# rejects obvious placeholder values such as "test-key" or "changeme").
AI_PROVIDER_MODE=offline

# Set to 1 to force live provider calls even when the configured credential
# looks like a placeholder. Leave unset during development.
# AI_FORCE_LIVE=

# -----------------------------------------------------------------------------
# Provider credentials — OPTIONAL
# -----------------------------------------------------------------------------
# Leave BOTH blank to stay in offline mode. Supplying one enables live calls
# for that provider and MAY INCUR USAGE CHARGES. Do not commit real keys.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# Backend API (FastAPI). Must match web-portal/.env.local VITE_API_URL.
BACKEND_PORT=8001
# Frontend dev server (Vite).
FRONTEND_PORT=3000
