# =============================================================================
# DEDAN Health — web portal example environment file
#
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# NEVER put a secret here — anything with the VITE_ prefix is shipped to the
# client and is publicly readable. The portal needs no credentials.
# =============================================================================

# Base URL of the DEDAN Health Clinical API.
# Must match the backend port. Change this if you set BACKEND_PORT elsewhere.
VITE_API_URL=http://localhost:8001

# Dev server port. Overridden by `npm run dev -- --port <n>`.
VITE_PORT=3000
